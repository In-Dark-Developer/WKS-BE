# EC2 서버에서 이 파일을 .env 로 복사해 실제 값을 채운다.
# .env 는 절대 git에 커밋하지 않는다 (.gitignore 대상).

APP_IMAGE=ghcr.io/<github-org-or-user>/wks:latest

DB_NAME=wks
DB_USERNAME=wks
DB_PASSWORD=

MAIL_USERNAME=
MAIL_PASSWORD=

GOOGLE_API_KEY=

CORS_ALLOWED_ORIGINS=https://your-frontend-domain.example
VERIFY_REDIRECT_URL=https://your-frontend-domain.example/verify
BACKEND_BASE_URL=https://your-backend-domain.example
SIGNUP_ALLOWED_EMAIL_DOMAINS=
