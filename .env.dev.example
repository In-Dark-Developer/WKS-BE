
# EC2의 /opt/wks-dev 에서 이 파일을 .env 로 복사해 실제 값을 채운다.
# .env 는 절대 git에 커밋하지 않는다 (.gitignore 대상).
# DB_HOST/DB_PORT는 docker-compose.dev.yml에 고정돼 있어 여기서 설정하지 않는다.

# APP_IMAGE는 dev 배포 워크플로(deploy-dev.yml)에서 :dev 태그로 덮어씀
APP_IMAGE=ghcr.io/in-dark-developer/wks-be:dev

# ← 운영(wks) 계정과 반드시 다른 값. db/init/init-wks-dev.sql 로 만든 계정 비밀번호
DB_NAME=wks_dev
DB_USERNAME=wks_dev
DB_PASSWORD=

MAIL_USERNAME=
MAIL_PASSWORD=

# ← 운영과 다른 키를 쓴다. 같은 키를 쓰면 dev 테스트 호출이 운영 무료 한도(gemini.max-per-day)를 갉아먹는다
GOOGLE_API_KEY=

CORS_ALLOWED_ORIGINS=https://dev.threadoffate.site,http://localhost:3000
VERIFY_REDIRECT_URL=https://dev.threadoffate.site/verify
DATING_VERIFY_REDIRECT_URL=https://dev.threadoffate.site/dating/verify
REAPPLY_URL=https://dev.threadoffate.site/dating/reapply
# 기존 사전신청자 재신청 초대 일괄 발송: off | dry-run | send. 쓰고 나면 반드시 off 로 되돌린다
REAPPLY_CAMPAIGN_MODE=off
BACKEND_BASE_URL=https://api-dev.threadoffate.site
SIGNUP_ALLOWED_EMAIL_DOMAINS=

AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ← 운영과 다른 카카오 앱(개발용)의 키. 카카오 디벨로퍼스에 별도 앱으로 등록해야 한다 (docs/runbook-dev-server.md 참고)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_ALLOWED_REDIRECT_URIS=

# ← 운영과 다른 값. 같은 시크릿을 쓰면 dev에서 발급한 JWT가 운영 API에서도 유효하게 검증된다
JWT_SECRET=
