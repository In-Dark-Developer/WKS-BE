# 이 파일을 application-local.yml 로 복사한 뒤 실제 값을 채워서 사용하세요.
# application-local.yml 은 .gitignore 에 등록되어 있어 커밋되지 않습니다.
# 아래 ${...} 값은 환경변수로 주입하거나, 로컬 전용이라면 이 파일에서 직접 값을 채워도 됩니다.

spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/wks
    username: wks
    password: ${DB_PASSWORD:postgres}
  mail:
    host: smtp.gmail.com
    port: 587
    username: ${MAIL_USERNAME}
    password: ${MAIL_PASSWORD}
    properties:
      mail:
        smtp:
          auth: true
          starttls:
            enable: true

gemini:
  api-key: ${GOOGLE_API_KEY}

# 카카오 로그인 — 값을 안 채우면 로그인 API 만 KAKAO_UNAVAILABLE 로 비활성화되고 나머지는 그대로 기동한다.
# redirectUri 는 프론트가 실제로 쓰는 콜백 주소와 정확히 같아야 한다 (예: http://localhost:5173/dev/kakao-callback).
app:
  auth:
    allowed-redirect-uris: ${KAKAO_ALLOWED_REDIRECT_URIS:http://localhost:5173/dev/kakao-callback}
    kakao:
      client-id: ${KAKAO_CLIENT_ID:}
      client-secret: ${KAKAO_CLIENT_SECRET:}
    jwt:
      # openssl rand -base64 48 로 생성. 32바이트 미만이면 기동 시 실패한다(JwtProvider).
      secret: ${JWT_SECRET:}
